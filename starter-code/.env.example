# ============================================================
#  .env.example — Mẫu cấu hình (SAFE TO COMMIT)
#  Copy file này thành .env và điền giá trị thật vào
#  cp .env.example .env
# ============================================================

# OpenRouter API Key — Lấy tại: https://openrouter.ai/keys
QWEN_API_KEY=your_openrouter_api_key_here

# OpenRouter base URL (giữ nguyên)
QWEN_BASE_URL=https://openrouter.ai/api/v1

# Model slug — Xem danh sách tại: https://openrouter.ai/models
AI_PROVIDER_OVERRIDE=qwen/qwen3.7-plus

